# =====================================================================
# Copy to .env and edit.  docker compose reads .env automatically.
#   cp .env.example .env
# Never commit .env - it holds secrets.
# =====================================================================

# ---- REQUIRED --------------------------------------------------------
# Keeps testers logged in across restarts. Generate once with:
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- Networking ------------------------------------------------------
# Host port the chatbot is published on: http://<host>:8080
APP_PORT=8080
SERVER_THREADS=8
# Set to 1 when served over HTTPS (reverse proxy or tunnel).
SESSION_COOKIE_SECURE=0

# ---- Models ----------------------------------------------------------
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:1.5b
USE_LLM=1
OLLAMA_TIMEOUT=60

# ---- Indexing --------------------------------------------------------
# Set to 1 to force a rebuild on next start, then set back to 0.
REBUILD_INDEX=0
# true adds LibreOffice to the image so Word EMF/WMF images convert to PNG
# inside the container. Adds ~400 MB. See DOCKER_GUIDE.md for the
# alternative (build the index on Windows and copy it in).
INSTALL_IMAGE_TOOLS=false
PARENT_TOPIC_LEVEL=3
IMAGE_RASTER_DPI=200

# ---- Retrieval tuning ------------------------------------------------
MIN_ANSWER_CONFIDENCE=0.30
MIN_VECTOR_SCORE=0.35
DOCUMENT_LOCK_MARGIN=0.10
SINGLE_DOCUMENT_CONTEXT=1
HEADING_TERM_DF_CEILING=0.12
MAX_CONTEXT_CHARS=12000
MAX_PARENT_INLINE_CHARS=4500
VERBATIM_PROCEDURE_ANSWERS=1
IMAGES_FROM_ANSWER_ONLY=1

# ---- Facility database ----------------------------------------------
# Key for database/facilities.enc. Generate once with:
#   python tools/build_facility_db.py --new-key
# WITHOUT THIS KEY THE FACILITY DATABASE CANNOT BE READ. Keep a copy safe.
FACILITY_DB_KEY=

# ---- Azure AD (optional - leave blank to use local accounts only) -----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in the Azure portal.
AZURE_REDIRECT_URI=http://localhost:8080/login/azure/callback
